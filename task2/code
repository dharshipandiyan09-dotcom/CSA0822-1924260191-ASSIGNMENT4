import os 
def process_month(folder): 
    attendance = {} 
    damaged = [] 
    try: 
        files = sorted( 
            f for f in os.listdir(folder) 
            if f.endswith(".txt") 
        ) 
    except FileNotFoundError: 
        print("Attendance folder not found.") 
        return 
    for filename in files: 
        path = os.path.join(folder, filename) 
        try: 
            with open(path, "r", encoding="utf-8") as file: 
                for line_no, line in enumerate(file, 1): 
                    try: 

                        parts = line.strip().split(",") 
                        if len(parts) != 3: 
                            raise ValueError("Missing fields") 
                        reg, date, status = parts 
                        if status not in ("P", "A"): 
                            raise ValueError("Invalid status") 
                        if not reg or not date: 
                            raise ValueError("Empty field") 
                        counts = attendance.setdefault( 
                            reg, {"P": 0, "A": 0} 
                        ) 
                        counts[status] += 1 
                    except ValueError as e: 
                        damaged.append( 
                            f"{filename}, Line {line_no}: {e}" 
                        ) 
        except (OSError, UnicodeDecodeError) as e: 
            damaged.append(f"{filename}: {e}") 
    with open("attendance_report.txt", "w", 
              encoding="utf-8") as report: 
        report.write("MONTHLY ATTENDANCE REPORT\n") 
        report.write("Below 75% Attendance:\n") 
        for reg, count in sorted(attendance.items()): 
            total = count["P"] + count["A"] 
            percentage = count["P"] / total * 100 
            report.write( 
                f"{reg}: {percentage:.2f}%\n" 
            ) 
            if percentage < 75: 
                report.write( 
                    f"Below 75%: {reg}\n" 
                ) 
    with open("damaged_lines.txt", "w", 
              encoding="utf-8") as log: 
        for error in damaged: 
            log.write(error + "\n") 
    print("Attendance Report Generated") 
    print("Damaged Records:", len(damaged)) 
