def save_returns(books): 
    with open("returns.log", "a", encoding="utf-8") as log: 
        for book in books: 
            log.write(book + "\n") 
def process(day_file): 
    try: 
        with open(day_file, "r", encoding="utf-8") as file: 
            books = file.read().splitlines() 
        save_returns(books) 
        print("Processed:", day_file) 
    except FileNotFoundError: 
        print("Missing file:", day_file) 
        with open("error.log", "a", encoding="utf-8") as log: 
            log.write(f"Missing file: {day_file}\n") 
# Create sample daily files 
for i in range(1, 4): 
    with open(f"day{i}.txt", "w", encoding="utf-8") as f: 
        f.write(f"Book A{i}\nBook B{i}\n") 
# Process three days 
open("returns.log", "w").close() 
for i in range(1, 4): 
    process(f"day{i}.txt") 
process("day4.txt") 
# Display final log 
print("\nFinal Return Log:") 
with open("returns.log", "r", encoding="utf-8") as log: 
    print(log.read()) 

