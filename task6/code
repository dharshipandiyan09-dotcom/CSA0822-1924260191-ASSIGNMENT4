import os 
import csv 
import re 
# Create sample department files 
departments = { 
    "CSE": [ 
        "101|Arun|CSE|arun@gmail.com|Dance;Music", 
        "102|Priya|CSE|priya@gmail.com|Music;Drama" 
    ], 
    "ECE": [ 
        "103|Kumar|ECE|kumar@gmail.com|Dance", 
        "104|Ravi|ECE|wrongemail|Music" 
    ], 
    "EEE": [ 
        "105|Divya|EEE|divya@gmail.com|Drama", 
        "101|Arun|EEE|arun@gmail.com|Dance" 

    ], 
    "MECH": [ 
        "106|Mani|MECH|mani@gmail.com|Music", 
        "107|Anu|MECH|Dance" 
    ], 
    "CIVIL": [ 
        "108|Siva|CIVIL|siva@gmail.com|Drama" 
    ] 
} 
os.makedirs("department_files", exist_ok=True) 
for dept, records in departments.items(): 
    with open(f"department_files/{dept}.txt", "w") as f: 
        f.write("\n".join(records)) 
# Process registrations 
master = [] 
errors = [] 
seen = set() 
events = {} 
for dept in departments: 
    filename = f"department_files/{dept}.txt" 
    try: 
        with open(filename, "r") as file: 
            for line_no, line in enumerate(file, 1): 
                try: 
                    parts = line.strip().split("|") 
                    if len(parts) != 5: 
                        raise ValueError("Invalid fields") 
                    reg, name, department, email, choices = parts 
                    if not all([reg, name, department, email, choices]): 
                        raise ValueError("Missing data") 
                    if not re.match(r"^[\w.-]+@[\w.-]+\.\w+$", email): 
                        raise ValueError("Invalid email") 

                    if reg in seen: 
                        raise ValueError("Duplicate registration") 
                    seen.add(reg) 
                    master.append([ 
                        reg, name, department, email, choices 
                    ]) 
                    for event in choices.split(";"): 
                        event = event.strip() 
                        events.setdefault(event, []).append( 
                            [reg, name, department] 
                        ) 
                except ValueError as e: 
                    errors.append( 
                        f"{filename}, Line {line_no}: {e}" 
                    ) 
    except FileNotFoundError: 
        errors.append(f"{filename}: File not found") 
# Write master list 
with open("master_list.csv", "w", newline="") as f: 
    writer = csv.writer(f) 
    writer.writerow(["Register No", "Name", "Department", 
                     "Email", "Events"]) 
    writer.writerows(master) 
# Write event-wise participant files 
for event, participants in events.items(): 
    safe_name = event.replace(" ", "_") 
    with open(f"{safe_name}.txt", "w") as f: 
        for person in participants: 
            f.write(" | ".join(person) + "\n") 
# Write summary report 
with open("summary_report.txt", "w") as f: 
    f.write("COLLEGE FEST SUMMARY\n") 
    f.write(f"Total Valid Registrations: {len(master)}\n") 
    for event, participants in events.items(): 
        f.write(f"{event}: {len(participants)} participants\n") 
# Write error log 
with open("error_log.txt", "w") as f: 
    for error in errors: 
        f.write(error + "\n") 
print("COLLEGE FEST REGISTRATION COMPLETED") 
print("Valid Registrations:", len(master)) 
print("Rejected Records:", len(errors)) 
print("Events:", len(events)) 
print("Master List: master_list.csv") 
print("Summary: summary_report.txt") 
print("Error Log: error_log.txt") 
print("Event-wise files created successfully.") 

